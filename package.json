{
  "name": "livepic",
  "version": "0.0.0-development",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./dist/index.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/browser.js": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "author": "reoberon",
  "license": "MIT",
  "description": "Gaze-tracking portrait sprite web component with a CLI to generate your own sprite sheets",
  "repository": {
    "type": "git",
    "url": "https://github.com/reoberon/livepic.git"
  },
  "homepage": "https://github.com/reoberon/livepic#readme",
  "bugs": {
    "url": "https://github.com/reoberon/livepic/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.build.json -w",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:smoke": "pnpm run build && vitest run --project smoke",
    "test:run": "pnpm run test:unit && pnpm run test:smoke",
    "coverage": "vitest run --project unit --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "bin": {
    "livepic": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "unpkg": "dist/browser.js",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/eslint-plugin": "^1.4.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "p-all": "^5.0.1",
    "replicate": "^1.4.0"
  }
}
